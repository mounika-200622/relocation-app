{
  "name": "relocation-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "mongo:local": "tsx scripts/mongo-local.ts",
    "photos:migrate": "tsx scripts/migrate-legacy-photos.ts",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cap sync android && cd android && gradlew assembleDebug",
    "android:wifi": "node scripts/android-wifi.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "country-state-city": "^3.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "mongodb": "^7.7.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.8",
    "world-countries": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
