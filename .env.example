# ---------- Databases ----------
# MySQL 8 (system of record). docker-compose.yml starts one on port 3306.
DATABASE_URL="mysql://nira:nira_password@localhost:3306/nira"
# MongoDB (chat messages + notifications). docker-compose.yml starts one on port 27017.
# No Docker? run `npm run mongo:local` for a throwaway in-memory server.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="nira"

# ---------- Auth ----------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seeded administrator (used by `npm run db:seed`)
ADMIN_EMAIL="admin@nira.local"
ADMIN_PASSWORD="change-me-please"

# ---------- File storage ----------
# Leave empty to store uploads in /public/uploads (dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Points of interest / geocoding ----------
# overpass (default, free OpenStreetMap) | google (needs GOOGLE_PLACES_API_KEY)
POI_PROVIDER="overpass"
GOOGLE_PLACES_API_KEY=""
OVERPASS_URL="https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"
# Nominatim requires an identifying User-Agent: app name + a contact URL or email
NOMINATIM_USER_AGENT="Nira-Student-Project/1.0 (https://github.com/mounika-200622/relocation-app)"

# ---------- Optional email (password reset). Without it, links are logged to the console. ----------
RESEND_API_KEY=""
EMAIL_FROM="Nira <no-reply@nira.local>"
