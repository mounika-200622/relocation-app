# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local agent/editor tooling (not part of the app)
/.agents/
/.claude/
/.windsurf/
skills-lock.json

# user uploads (served from /public/uploads in dev only)
/public/uploads/*
!/public/uploads/.gitkeep

# env files: only the example is committed
!.env.example

# local MongoDB data (npm run mongo:local)
/.mongo-data/

# Wi-Fi debug build copied here by npm run android:wifi
/Nira-debug.apk
